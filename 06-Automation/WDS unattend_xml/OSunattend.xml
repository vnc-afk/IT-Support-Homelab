<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- SPECIALIZE -->
    <settings pass="specialize">
        <component name="Microsoft-Windows-Shell-Setup"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral"
                   versionScope="nonSxS">

            <TimeZone>Singapore Standard Time</TimeZone>

        </component>
    </settings>


    <!-- OOBE SYSTEM -->
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral"
                   versionScope="nonSxS">

            <!-- Create local account -->
            <UserAccounts>
                <LocalAccounts>

                    <LocalAccount wcm:action="add">
                        <Name>ITSupport</Name>
                        <DisplayName>IT Support</DisplayName>
                        <Description>Local IT Support Administrator</Description>
                        <Group>Administrators</Group>
                        <Password>
                            <Value>admin</Value>
                            <PlainText>true</PlainText>
                        </Password>
                    </LocalAccount>

                </LocalAccounts>
            </UserAccounts>


            <!-- Automatically log in as ITSupport -->
            <AutoLogon>
                <Enabled>true</Enabled>
                <Username>ITSupport</Username>
                <Password>
                    <Value>admin</Value>
                    <PlainText>true</PlainText>
                </Password>
                <LogonCount>1</LogonCount>
            </AutoLogon>


            <!-- OOBE settings -->
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <NetworkLocation>Work</NetworkLocation>
                <SkipMachineOOBE>true</SkipMachineOOBE>
                <SkipUserOOBE>true</SkipUserOOBE>
            </OOBE>

        </component>
    </settings>


    <!-- WIM IMAGE -->
    <cpi:offlineImage
        cpi:source="wim:c:/images/install.wim#Windows 10 Pro"
        xmlns:cpi="urn:schemas-microsoft-com:cpi" />

</unattend>